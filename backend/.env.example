# GreenPT AI
GREENPT_API_KEY=your_greenpt_api_key_here
GREENPT_BASE_URL=https://api.greenpt.ai/v1
GREENPT_MODEL=gemma4

# Weather — free tier at openweathermap.org
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google OAuth — create credentials at console.cloud.google.com
# Enable: Google Calendar API + Gmail API
# Authorised redirect URI: {APP_BASE_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Base URL of this server (no trailing slash)
# Production: https://your-domain.com
# Local dev backend: http://localhost:8000
APP_BASE_URL=http://localhost:8000

# Where to redirect after Google OAuth completes
# Production: same as APP_BASE_URL
# Local dev (Vite): http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
